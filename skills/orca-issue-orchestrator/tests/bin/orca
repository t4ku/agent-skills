#!/usr/bin/env bash
# Fake `orca` for the Issue-script tests. Appends its argv to $FAKE_LOG as one
# JSON array per line and answers from recorded JSON under $FAKE_FIXTURES.
# A file of the same name under $FAKE_OVERRIDES (if set) wins.
set -u

{ printf '%s\0' orca "$@"; } | jq -Rsc 'split("\u0000") | .[:-1]' >> "$FAKE_LOG"

fixture() {
  if [ -n "${FAKE_OVERRIDES:-}" ] && [ -f "$FAKE_OVERRIDES/$1.fail" ]; then
    printf 'fake orca: %s set to fail\n' "$1" >&2
    exit 1
  elif [ -n "${FAKE_OVERRIDES:-}" ] && [ -f "$FAKE_OVERRIDES/$1" ]; then
    cat "$FAKE_OVERRIDES/$1"
  elif [ -f "$FAKE_FIXTURES/$1" ]; then
    cat "$FAKE_FIXTURES/$1"
  else
    printf 'fake orca: no fixture %s\n' "$1" >&2
    exit 1
  fi
}

# value_of <flag> <args...>: the argument after <flag>.
value_of() {
  local flag="$1"
  shift
  while [ $# -gt 0 ]; do
    if [ "$1" = "$flag" ]; then
      printf '%s' "${2:-}"
      return
    fi
    shift
  done
}

case "${1:-} ${2:-}" in
  "repo list") fixture orca-repo-list.json ;;
  "worktree list") fixture orca-worktree-list.json ;;
  "orchestration run-current") fixture orca-run-current.json ;;
  "orchestration task-create") fixture orca-task-create.json ;;
  "orchestration worker-list") fixture "orca-worker-list-$(value_of --run "$@").json" ;;
  *)
    # Mutations the scripts must never run (worker-start, worktree set, ...).
    printf '{"ok":true,"result":{}}\n'
    ;;
esac
